{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Softbank-Hackathon-Finals/platform/docs/controls/control-result.schema.json",
  "title": "통제 시험 결과 · 증거 형식 (T5)",
  "description": "T14가 만드는 ControlRun과 T19가 만드는 GateComparison. 판정 규칙과 스키마가 강제하지 못하는 검사는 docs/controls/README.md.",
  "oneOf": [
    {
      "$ref": "#/$defs/ControlRun"
    },
    {
      "$ref": "#/$defs/GateComparison"
    }
  ],
  "$defs": {
    "ControlId": {
      "enum": [
        "SEC-01",
        "ENC-01",
        "ENC-02",
        "AUD-01",
        "NET-01",
        "IAM-01",
        "ISO-01",
        "DR-01"
      ]
    },
    "TestId": {
      "type": "string",
      "pattern": "^(SEC-01|ENC-01|ENC-02|AUD-01|NET-01|IAM-01|ISO-01|DR-01)\\.[0-9]+$"
    },
    "Verdict": {
      "enum": [
        "PASS",
        "FAIL",
        "UNKNOWN"
      ]
    },
    "UnknownReason": {
      "description": "시험 결과(T14)에 붙이는 사유. 증거 만료 · 방법 불일치는 게이트(GateRow.reason)가 판단한다.",
      "enum": [
        "POSITIVE_CONTROL_FAILED",
        "OBSERVATION_DENIED",
        "UNEXPECTED_RESPONSE",
        "TIMEOUT",
        "TOOL_ERROR",
        "NOT_RUN"
      ]
    },
    "Outcome": {
      "description": "기대 · 관찰 결과. deny/allow: 접근 시도, present/absent: 검색 · 탐지, enabled/disabled: 설정 상태, success/failure: 동작(연결 · 복원 · 회전).",
      "enum": [
        "deny",
        "allow",
        "present",
        "absent",
        "enabled",
        "disabled",
        "success",
        "failure"
      ]
    },
    "Timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "Evidence": {
      "type": "object",
      "description": "비밀 원문을 넣지 않는다. 출력은 해시와 마스킹한 발췌만 남긴다.",
      "required": [
        "collected_at",
        "expires_at",
        "tool",
        "output_sha256"
      ],
      "additionalProperties": false,
      "properties": {
        "collected_at": {
          "$ref": "#/$defs/Timestamp"
        },
        "expires_at": {
          "$ref": "#/$defs/Timestamp"
        },
        "tool": {
          "type": "string",
          "description": "예: aws-cli, kubectl, psql, nmap, gitleaks, prowler, kube-bench"
        },
        "tool_version": {
          "type": "string"
        },
        "command": {
          "type": "string",
          "description": "실행한 명령. 토큰 · 비밀번호는 마스킹한다."
        },
        "output_sha256": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "excerpt": {
          "type": "string",
          "maxLength": 2048,
          "description": "판정 근거가 되는 출력 발췌 (마스킹)"
        },
        "artifact_uri": {
          "type": "string",
          "description": "전체 출력 보관 위치 (예: 감사 로그 저장소 경로)"
        },
        "signature": {
          "type": "object",
          "required": [
            "alg",
            "key_id",
            "value"
          ],
          "additionalProperties": false,
          "properties": {
            "alg": {
              "const": "ed25519"
            },
            "key_id": {
              "type": "string"
            },
            "value": {
              "type": "string",
              "description": "base64"
            }
          }
        }
      }
    },
    "ExceptionApproval": {
      "type": "object",
      "description": "대체 불가 예외. 게이트에서 사람이 승인한다. 동등 판정에 넣지 않고 따로 표시한다.",
      "required": [
        "approved_by",
        "approved_at",
        "expires_at",
        "compensating_control",
        "reason"
      ],
      "additionalProperties": false,
      "properties": {
        "approved_by": {
          "type": "string"
        },
        "approved_at": {
          "$ref": "#/$defs/Timestamp"
        },
        "expires_at": {
          "$ref": "#/$defs/Timestamp"
        },
        "compensating_control": {
          "type": "string"
        },
        "reason": {
          "type": "string"
        }
      }
    },
    "TestResult": {
      "type": "object",
      "required": [
        "test_id",
        "control_id",
        "method_version",
        "expected",
        "observed",
        "positive_control",
        "verdict",
        "unknown_reason",
        "evidence"
      ],
      "additionalProperties": false,
      "properties": {
        "test_id": {
          "$ref": "#/$defs/TestId"
        },
        "control_id": {
          "$ref": "#/$defs/ControlId"
        },
        "method_version": {
          "type": "string",
          "description": "시험 방법 버전. 양쪽이 다르면 게이트가 비교하지 않는다."
        },
        "expected": {
          "$ref": "#/$defs/Outcome"
        },
        "observed": {
          "description": "관찰할 수 없었으면 null",
          "oneOf": [
            {
              "$ref": "#/$defs/Outcome"
            },
            {
              "type": "null"
            }
          ]
        },
        "positive_control": {
          "enum": [
            "pass",
            "fail",
            "not_applicable"
          ]
        },
        "verdict": {
          "$ref": "#/$defs/Verdict"
        },
        "unknown_reason": {
          "oneOf": [
            {
              "$ref": "#/$defs/UnknownReason"
            },
            {
              "type": "null"
            }
          ]
        },
        "evidence": {
          "description": "시험이 돌지 않았으면 null (NOT_RUN)",
          "oneOf": [
            {
              "$ref": "#/$defs/Evidence"
            },
            {
              "type": "null"
            }
          ]
        },
        "started_at": {
          "$ref": "#/$defs/Timestamp"
        },
        "duration_ms": {
          "type": "integer",
          "minimum": 0
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "verdict": {
                "const": "UNKNOWN"
              }
            }
          },
          "then": {
            "properties": {
              "unknown_reason": {
                "$ref": "#/$defs/UnknownReason"
              }
            }
          },
          "else": {
            "properties": {
              "unknown_reason": {
                "type": "null"
              }
            }
          }
        },
        {
          "description": "PASS · FAIL은 관찰값 · 통과한 대조군 · 증거가 있어야 한다. 대조군이 실패했으면 UNKNOWN이다.",
          "if": {
            "properties": {
              "verdict": {
                "enum": [
                  "PASS",
                  "FAIL"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "observed": {
                "$ref": "#/$defs/Outcome"
              },
              "positive_control": {
                "enum": [
                  "pass",
                  "not_applicable"
                ]
              },
              "evidence": {
                "$ref": "#/$defs/Evidence"
              }
            }
          }
        }
      ]
    },
    "ControlRun": {
      "type": "object",
      "description": "한 환경에서 한 번 돌린 통제 시험 묶음. GET /v1/environments/{id}/controls의 응답.",
      "required": [
        "kind",
        "schema_version",
        "run_id",
        "environment",
        "app",
        "started_at",
        "finished_at",
        "results"
      ],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "control_run"
        },
        "schema_version": {
          "const": "1"
        },
        "run_id": {
          "type": "string"
        },
        "environment": {
          "type": "object",
          "required": [
            "id",
            "role",
            "ref"
          ],
          "additionalProperties": false,
          "properties": {
            "id": {
              "type": "string"
            },
            "role": {
              "enum": [
                "source",
                "target",
                "rehearsal"
              ]
            },
            "ref": {
              "type": "string",
              "description": "예: aws:eks/source, onprem:rke2/target"
            }
          }
        },
        "app": {
          "type": "string",
          "description": "등록된 앱 (예: demo-chat)"
        },
        "started_at": {
          "$ref": "#/$defs/Timestamp"
        },
        "finished_at": {
          "$ref": "#/$defs/Timestamp"
        },
        "results": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/TestResult"
          }
        }
      }
    },
    "GateRow": {
      "type": "object",
      "required": [
        "test_id",
        "control_id",
        "question",
        "source_verdict",
        "target_verdict",
        "decision",
        "reason",
        "improved",
        "exception"
      ],
      "additionalProperties": false,
      "properties": {
        "test_id": {
          "$ref": "#/$defs/TestId"
        },
        "control_id": {
          "$ref": "#/$defs/ControlId"
        },
        "question": {
          "type": "string"
        },
        "source_verdict": {
          "$ref": "#/$defs/Verdict"
        },
        "target_verdict": {
          "$ref": "#/$defs/Verdict"
        },
        "decision": {
          "enum": [
            "PASS",
            "BLOCK",
            "EXCEPTION"
          ]
        },
        "reason": {
          "enum": [
            "BOTH_PASS",
            "IMPROVED",
            "TARGET_FAIL",
            "SOURCE_UNKNOWN",
            "TARGET_UNKNOWN",
            "EVIDENCE_EXPIRED",
            "METHOD_MISMATCH",
            "EXCEPTION_APPROVED"
          ]
        },
        "improved": {
          "type": "boolean",
          "description": "출발지 FAIL → 목적지 PASS"
        },
        "exception": {
          "oneOf": [
            {
              "$ref": "#/$defs/ExceptionApproval"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "decision": {
                "const": "EXCEPTION"
              }
            }
          },
          "then": {
            "properties": {
              "exception": {
                "$ref": "#/$defs/ExceptionApproval"
              },
              "reason": {
                "const": "EXCEPTION_APPROVED"
              }
            }
          },
          "else": {
            "properties": {
              "exception": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
    "GateComparison": {
      "type": "object",
      "description": "원본 대조 게이트(T19)의 보안 질문 판정. 하나라도 BLOCK이면 decision은 BLOCK.",
      "required": [
        "kind",
        "schema_version",
        "gate_id",
        "evaluated_at",
        "source_run_id",
        "target_run_id",
        "decision",
        "rows"
      ],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "gate_comparison"
        },
        "schema_version": {
          "const": "1"
        },
        "gate_id": {
          "type": "string"
        },
        "evaluated_at": {
          "$ref": "#/$defs/Timestamp"
        },
        "source_run_id": {
          "type": "string"
        },
        "target_run_id": {
          "type": "string"
        },
        "decision": {
          "enum": [
            "PASS",
            "BLOCK"
          ]
        },
        "rows": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/GateRow"
          }
        }
      }
    }
  }
}
