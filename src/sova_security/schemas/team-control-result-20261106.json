{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Softbank-Hackathon-Finals/platform/docs/controls/control-result.schema.json",
  "title": "통제 시험 결과 · 증거 형식 (T5)",
  "description": "T14가 만드는 ControlRun, T19가 만드는 GateComparison, 게이트 범위를 정하는 EvaluationProfiles. 판정 규칙과 스키마가 강제하지 못하는 검사는 docs/controls/README.md.",
  "oneOf": [
    {
      "$ref": "#/$defs/ControlRun"
    },
    {
      "$ref": "#/$defs/GateComparison"
    },
    {
      "$ref": "#/$defs/EvaluationProfiles"
    }
  ],
  "$defs": {
    "ControlId": {
      "enum": [
        "SEC-01",
        "ENC-01",
        "ENC-02",
        "AUD-01",
        "NET-01",
        "IAM-01",
        "ISO-01",
        "DR-01"
      ]
    },
    "TestId": {
      "type": "string",
      "pattern": "^(SEC-01|ENC-01|ENC-02|AUD-01|NET-01|IAM-01|ISO-01|DR-01)\\.[0-9]+$"
    },
    "Verdict": {
      "enum": [
        "PASS",
        "FAIL",
        "UNKNOWN"
      ]
    },
    "UnknownReason": {
      "description": "시험 결과(T14)에 붙이는 사유. 증거 만료 · 방법 불일치는 게이트(GateRow.reason)가 판단한다.",
      "enum": [
        "POSITIVE_CONTROL_FAILED",
        "OBSERVATION_DENIED",
        "UNEXPECTED_RESPONSE",
        "TIMEOUT",
        "TOOL_ERROR",
        "NOT_RUN"
      ]
    },
    "Outcome": {
      "description": "기대 · 관찰 결과. deny/allow: 접근 시도, present/absent: 검색 · 탐지, enabled/disabled: 설정 상태, success/failure: 동작(연결 · 복원 · 회전).",
      "enum": [
        "deny",
        "allow",
        "present",
        "absent",
        "enabled",
        "disabled",
        "success",
        "failure"
      ]
    },
    "Timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "Evidence": {
      "type": "object",
      "description": "비밀 원문을 넣지 않는다. 출력은 해시와 마스킹한 발췌만 남긴다.",
      "required": [
        "collected_at",
        "expires_at",
        "tool",
        "output_sha256"
      ],
      "additionalProperties": false,
      "properties": {
        "collected_at": {
          "$ref": "#/$defs/Timestamp"
        },
        "expires_at": {
          "$ref": "#/$defs/Timestamp"
        },
        "tool": {
          "type": "string",
          "description": "예: aws-cli, kubectl, psql, nmap, gitleaks, prowler, kube-bench"
        },
        "tool_version": {
          "type": "string"
        },
        "command": {
          "type": "string",
          "description": "실행한 명령. 토큰 · 비밀번호는 마스킹한다."
        },
        "output_sha256": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "excerpt": {
          "type": "string",
          "maxLength": 2048,
          "description": "판정 근거가 되는 출력 발췌 (마스킹)"
        },
        "artifact_uri": {
          "type": "string",
          "description": "전체 출력 보관 위치 (예: 감사 로그 저장소 경로)"
        },
        "signature": {
          "type": "object",
          "required": [
            "alg",
            "key_id",
            "value"
          ],
          "additionalProperties": false,
          "properties": {
            "alg": {
              "const": "ed25519"
            },
            "key_id": {
              "type": "string"
            },
            "value": {
              "type": "string",
              "description": "base64"
            }
          }
        }
      }
    },
    "ExceptionApproval": {
      "type": "object",
      "description": "대체 불가 예외. 게이트에서 사람이 승인한다. 동등 판정에 넣지 않고 따로 표시한다. 권한의 근거는 approval_id가 가리키는 서버 승인 기록(T10)이다. 이 문서의 approved_by는 표시용이다. 계획·평가 단위 예외이며 환경 정책 예외가 아니다. scope.context_digest는 서버 승인 기록과 현재 평가 context에 모두 일치해야 한다.",
      "required": [
        "approval_id",
        "scope",
        "approved_by",
        "approved_at",
        "expires_at",
        "compensating_control",
        "reason"
      ],
      "additionalProperties": false,
      "properties": {
        "approval_id": {
          "type": "string",
          "minLength": 1,
          "description": "T10이 저장한 승인 기록의 ID. T19 · T10은 이 기록이 있고 아래 scope · 시각과 같은지 확인한다."
        },
        "scope": {
          "type": "object",
          "description": "승인이 적용되는 범위. 하나라도 현재 게이트와 다르면 예외는 무효다(EXCEPTION_INVALID).",
          "required": [
            "app",
            "target_environment_id",
            "test_id",
            "profile_id",
            "profile_version",
            "context_digest"
          ],
          "additionalProperties": false,
          "properties": {
            "app": {
              "type": "string"
            },
            "target_environment_id": {
              "type": "string"
            },
            "test_id": {
              "$ref": "#/$defs/TestId"
            },
            "profile_id": {
              "type": "string"
            },
            "profile_version": {
              "type": "string"
            },
            "context_digest": {
              "$ref": "#/$defs/ContextDigest"
            }
          }
        },
        "approved_by": {
          "type": "string",
          "description": "표시용. 권한 근거가 아니다."
        },
        "approved_at": {
          "$ref": "#/$defs/Timestamp"
        },
        "expires_at": {
          "$ref": "#/$defs/Timestamp"
        },
        "compensating_control": {
          "type": "string"
        },
        "reason": {
          "type": "string"
        }
      }
    },
    "TestResult": {
      "type": "object",
      "required": [
        "test_id",
        "control_id",
        "method_version",
        "expected",
        "observed",
        "positive_control",
        "verdict",
        "unknown_reason",
        "evidence"
      ],
      "additionalProperties": false,
      "properties": {
        "test_id": {
          "$ref": "#/$defs/TestId"
        },
        "control_id": {
          "$ref": "#/$defs/ControlId"
        },
        "method_version": {
          "type": "string",
          "description": "시험 방법 버전. 양쪽이 다르면 게이트가 비교하지 않는다."
        },
        "expected": {
          "$ref": "#/$defs/Outcome"
        },
        "observed": {
          "description": "관찰할 수 없었으면 null",
          "oneOf": [
            {
              "$ref": "#/$defs/Outcome"
            },
            {
              "type": "null"
            }
          ]
        },
        "positive_control": {
          "enum": [
            "pass",
            "fail",
            "not_applicable"
          ]
        },
        "verdict": {
          "$ref": "#/$defs/Verdict"
        },
        "unknown_reason": {
          "oneOf": [
            {
              "$ref": "#/$defs/UnknownReason"
            },
            {
              "type": "null"
            }
          ]
        },
        "evidence": {
          "description": "시험이 돌지 않았으면 null (NOT_RUN)",
          "oneOf": [
            {
              "$ref": "#/$defs/Evidence"
            },
            {
              "type": "null"
            }
          ]
        },
        "started_at": {
          "$ref": "#/$defs/Timestamp"
        },
        "duration_ms": {
          "type": "integer",
          "minimum": 0
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "verdict": {
                "const": "UNKNOWN"
              }
            }
          },
          "then": {
            "properties": {
              "unknown_reason": {
                "$ref": "#/$defs/UnknownReason"
              }
            }
          },
          "else": {
            "properties": {
              "unknown_reason": {
                "type": "null"
              }
            }
          }
        },
        {
          "description": "PASS · FAIL은 관찰값 · 통과한 대조군 · 증거가 있어야 한다. 대조군이 실패했으면 UNKNOWN이다.",
          "if": {
            "properties": {
              "verdict": {
                "enum": [
                  "PASS",
                  "FAIL"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "observed": {
                "$ref": "#/$defs/Outcome"
              },
              "positive_control": {
                "enum": [
                  "pass",
                  "not_applicable"
                ]
              },
              "evidence": {
                "$ref": "#/$defs/Evidence"
              }
            }
          }
        },
        {
          "$ref": "#/$defs/TestIdMatchesControl"
        }
      ]
    },
    "ControlRun": {
      "type": "object",
      "description": "한 환경에서 한 번 돌린 통제 시험 묶음. GET /v1/environments/{id}/controls의 응답.",
      "required": [
        "kind",
        "schema_version",
        "run_id",
        "environment",
        "app",
        "started_at",
        "finished_at",
        "results"
      ],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "control_run"
        },
        "schema_version": {
          "const": "1"
        },
        "run_id": {
          "type": "string"
        },
        "environment": {
          "type": "object",
          "required": [
            "id",
            "role",
            "ref"
          ],
          "additionalProperties": false,
          "properties": {
            "id": {
              "type": "string"
            },
            "role": {
              "enum": [
                "source",
                "target",
                "rehearsal"
              ]
            },
            "ref": {
              "type": "string",
              "description": "예: aws:eks/source, onprem:rke2/target"
            }
          }
        },
        "app": {
          "type": "string",
          "description": "등록된 앱 (예: demo-chat)"
        },
        "started_at": {
          "$ref": "#/$defs/Timestamp"
        },
        "finished_at": {
          "$ref": "#/$defs/Timestamp"
        },
        "results": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/TestResult"
          }
        }
      }
    },
    "GateRow": {
      "type": "object",
      "required": [
        "test_id",
        "control_id",
        "question",
        "source_verdict",
        "target_verdict",
        "decision",
        "reason",
        "improved",
        "exception"
      ],
      "additionalProperties": false,
      "properties": {
        "test_id": {
          "$ref": "#/$defs/TestId"
        },
        "control_id": {
          "$ref": "#/$defs/ControlId"
        },
        "question": {
          "type": "string"
        },
        "source_verdict": {
          "$ref": "#/$defs/Verdict"
        },
        "target_verdict": {
          "$ref": "#/$defs/Verdict"
        },
        "decision": {
          "enum": [
            "PASS",
            "BLOCK",
            "EXCEPTION"
          ]
        },
        "reason": {
          "enum": [
            "BOTH_PASS",
            "IMPROVED",
            "TARGET_FAIL",
            "SOURCE_UNKNOWN",
            "TARGET_UNKNOWN",
            "EVIDENCE_EXPIRED",
            "METHOD_MISMATCH",
            "EXCEPTION_APPROVED",
            "MISSING_RESULT",
            "DUPLICATE_RESULT",
            "INVARIANT_VIOLATION",
            "EXCEPTION_INVALID"
          ]
        },
        "improved": {
          "type": "boolean",
          "description": "출발지 FAIL → 목적지 PASS"
        },
        "exception": {
          "oneOf": [
            {
              "$ref": "#/$defs/ExceptionApproval"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "decision": {
                "const": "EXCEPTION"
              }
            }
          },
          "then": {
            "properties": {
              "exception": {
                "$ref": "#/$defs/ExceptionApproval"
              },
              "reason": {
                "const": "EXCEPTION_APPROVED"
              }
            }
          },
          "else": {
            "properties": {
              "exception": {
                "type": "null"
              }
            }
          }
        },
        {
          "$ref": "#/$defs/TestIdMatchesControl"
        }
      ]
    },
    "GateComparison": {
      "type": "object",
      "description": "원본 대조 게이트(T19)의 보안 질문 판정. 행은 평가 프로필의 required_test_ids에서 만든다(실행 결과에서 만들지 않는다). 하나라도 BLOCK이거나 run_issues가 있으면 decision은 BLOCK.",
      "required": [
        "kind",
        "schema_version",
        "gate_id",
        "profile",
        "app",
        "evaluated_at",
        "source_run_id",
        "target_run_id",
        "source_environment_id",
        "target_environment_id",
        "run_issues",
        "decision",
        "rows",
        "context_digest"
      ],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "gate_comparison"
        },
        "schema_version": {
          "const": "1"
        },
        "gate_id": {
          "type": "string"
        },
        "profile": {
          "type": "object",
          "description": "이 게이트가 쓴 평가 프로필 (profiles.json)",
          "required": [
            "id",
            "version"
          ],
          "additionalProperties": false,
          "properties": {
            "id": {
              "type": "string"
            },
            "version": {
              "type": "string"
            }
          }
        },
        "app": {
          "type": "string"
        },
        "evaluated_at": {
          "$ref": "#/$defs/Timestamp"
        },
        "source_run_id": {
          "type": "string"
        },
        "target_run_id": {
          "type": "string"
        },
        "source_environment_id": {
          "type": "string"
        },
        "target_environment_id": {
          "type": "string",
          "description": "예외 승인의 scope.target_environment_id와 같아야 한다"
        },
        "run_issues": {
          "type": "array",
          "description": "두 실행 묶음 자체의 문제. 하나라도 있으면 BLOCK이다.",
          "uniqueItems": true,
          "items": {
            "enum": [
              "RUN_NOT_FOUND",
              "APP_MISMATCH",
              "ENVIRONMENT_ROLE_MISMATCH",
              "SAME_ENVIRONMENT"
            ]
          }
        },
        "decision": {
          "enum": [
            "PASS",
            "BLOCK"
          ]
        },
        "rows": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/GateRow"
          }
        },
        "context_digest": {
          "$ref": "#/$defs/ContextDigest"
        }
      },
      "allOf": [
        {
          "description": "PASS면 BLOCK 행과 실행 묶음 문제가 없다.",
          "if": {
            "properties": {
              "decision": {
                "const": "PASS"
              }
            }
          },
          "then": {
            "properties": {
              "rows": {
                "items": {
                  "properties": {
                    "decision": {
                      "enum": [
                        "PASS",
                        "EXCEPTION"
                      ]
                    }
                  }
                }
              },
              "run_issues": {
                "maxItems": 0
              }
            }
          }
        },
        {
          "description": "BLOCK이면 BLOCK 행이나 실행 묶음 문제가 하나 이상 있다.",
          "if": {
            "properties": {
              "decision": {
                "const": "BLOCK"
              }
            }
          },
          "then": {
            "anyOf": [
              {
                "properties": {
                  "rows": {
                    "contains": {
                      "properties": {
                        "decision": {
                          "const": "BLOCK"
                        }
                      }
                    }
                  }
                }
              },
              {
                "properties": {
                  "run_issues": {
                    "minItems": 1
                  }
                }
              }
            ]
          }
        }
      ]
    },
    "TestIdMatchesControl": {
      "description": "시험 ID의 앞부분과 통제 ID가 같아야 한다 (예: IAM-01.1 → IAM-01).",
      "allOf": [
        {
          "if": {
            "properties": {
              "test_id": {
                "pattern": "^SEC-01\\."
              }
            },
            "required": [
              "test_id"
            ]
          },
          "then": {
            "properties": {
              "control_id": {
                "const": "SEC-01"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "test_id": {
                "pattern": "^ENC-01\\."
              }
            },
            "required": [
              "test_id"
            ]
          },
          "then": {
            "properties": {
              "control_id": {
                "const": "ENC-01"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "test_id": {
                "pattern": "^ENC-02\\."
              }
            },
            "required": [
              "test_id"
            ]
          },
          "then": {
            "properties": {
              "control_id": {
                "const": "ENC-02"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "test_id": {
                "pattern": "^AUD-01\\."
              }
            },
            "required": [
              "test_id"
            ]
          },
          "then": {
            "properties": {
              "control_id": {
                "const": "AUD-01"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "test_id": {
                "pattern": "^NET-01\\."
              }
            },
            "required": [
              "test_id"
            ]
          },
          "then": {
            "properties": {
              "control_id": {
                "const": "NET-01"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "test_id": {
                "pattern": "^IAM-01\\."
              }
            },
            "required": [
              "test_id"
            ]
          },
          "then": {
            "properties": {
              "control_id": {
                "const": "IAM-01"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "test_id": {
                "pattern": "^ISO-01\\."
              }
            },
            "required": [
              "test_id"
            ]
          },
          "then": {
            "properties": {
              "control_id": {
                "const": "ISO-01"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "test_id": {
                "pattern": "^DR-01\\."
              }
            },
            "required": [
              "test_id"
            ]
          },
          "then": {
            "properties": {
              "control_id": {
                "const": "DR-01"
              }
            }
          }
        }
      ]
    },
    "EvaluationProfiles": {
      "type": "object",
      "description": "시험별 불변조건(카탈로그)과 게이트가 요구하는 시험 범위(프로필). profiles.json.",
      "required": [
        "kind",
        "schema_version",
        "tests",
        "profiles"
      ],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "evaluation_profiles"
        },
        "schema_version": {
          "const": "1"
        },
        "tests": {
          "type": "object",
          "description": "시험 ID → 결과가 지켜야 할 값. 결과가 하나라도 다르면 그 행은 INVARIANT_VIOLATION으로 BLOCK이다.",
          "propertyNames": {
            "$ref": "#/$defs/TestId"
          },
          "additionalProperties": {
            "type": "object",
            "required": [
              "control_id",
              "method_version",
              "expected",
              "positive_control"
            ],
            "additionalProperties": false,
            "properties": {
              "control_id": {
                "$ref": "#/$defs/ControlId"
              },
              "method_version": {
                "type": "string"
              },
              "expected": {
                "$ref": "#/$defs/Outcome"
              },
              "positive_control": {
                "enum": [
                  "required",
                  "not_applicable"
                ],
                "description": "required면 PASS · FAIL 결과의 positive_control은 pass여야 한다"
              }
            }
          }
        },
        "profiles": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "id",
              "version",
              "app",
              "description",
              "required_test_ids"
            ],
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string"
              },
              "version": {
                "type": "string"
              },
              "app": {
                "type": "string"
              },
              "description": {
                "type": "string"
              },
              "required_test_ids": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "$ref": "#/$defs/TestId"
                }
              }
            }
          }
        }
      }
    },
    "ContextDigest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "description": "T10이 고정한 평가 context의 SHA-256. 알고리즘과 구성 필드는 README 4절 참조. 문자열 자체는 권한 근거가 아니다."
    }
